<Window x:Class="ZeiLand.TrayMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeiLand"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" SizeToContent="WidthAndHeight" Opacity="0"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="White" UseLayoutRounding="True">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- A menu row: glyph (Tag), label (Content). -->
        <Style x:Key="Item" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="10,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph" Width="16" Margin="0,0,12,0" FontSize="14"
                                           FontFamily="{StaticResource IconFont}" Foreground="#CCFFFFFF"
                                           VerticalAlignment="Center" TextAlignment="Center"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A menu row with a small switch on the right. -->
        <Style x:Key="ToggleItem" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Width="16" Margin="0,0,12,0" FontSize="14" FontFamily="{StaticResource IconFont}"
                                           Foreground="#CCFFFFFF" VerticalAlignment="Center" TextAlignment="Center"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                <Border x:Name="Track" Grid.Column="2" Width="32" Height="16" CornerRadius="8" Margin="16,0,0,0"
                                        BorderBrush="#99FFFFFF" BorderThickness="1" Background="Transparent">
                                    <Ellipse x:Name="Thumb" Width="10" Height="10" Margin="2,0,0,0" Fill="#CCFFFFFF"
                                             HorizontalAlignment="Left" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#30D158" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#30D158" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="#1AFFFFFF" />
        </Style>
    </Window.Resources>

    <!-- The outer margin leaves room for the shadow. -->
    <Border x:Name="Panel" Margin="12" Width="236" Padding="4" CornerRadius="10"
            Background="#F21F1F1F" BorderBrush="#24FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <!-- Header: a tiny island and the version. -->
            <StackPanel Orientation="Horizontal" Margin="10,8,10,8">
                <Border Width="22" Height="9" CornerRadius="4.5" Background="Black" BorderBrush="#4DFFFFFF"
                        BorderThickness="1" VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0" Text="ZeiLand" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" Margin="6,1,0,0" FontSize="11.5" Foreground="#66FFFFFF"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Border Style="{StaticResource Separator}" />

            <Button x:Name="SettingsItem" Style="{StaticResource Item}" Tag="&#xE713;" Content="{DynamicResource Settings}" />
            <CheckBox x:Name="AutostartItem" Style="{StaticResource ToggleItem}" Tag="&#xE768;" Content="{DynamicResource StartWithWindows}" />
            <CheckBox x:Name="AodItem" Style="{StaticResource ToggleItem}" Tag="&#xE7F4;" Content="{DynamicResource AodTitle}" />

            <Border Style="{StaticResource Separator}" />
            <Button x:Name="ExitItem" Style="{StaticResource Item}" Tag="&#xE7E8;" Content="{DynamicResource Exit}" />
        </StackPanel>
    </Border>
</Window>
