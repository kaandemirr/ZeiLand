<Window x:Class="ZeiLand.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource WelcomeTitle}"
        Width="580" Height="460" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="White">

    <Window.Resources>
        <SolidColorBrush x:Key="SecondaryText" Color="#A6FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#30D158" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="PageText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="LineHeight" Value="20" />
        </Style>

        <!-- One tip: a round glyph on the left, a bold lead and a line of explanation. -->
        <Style x:Key="TipGlyph" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TipLead" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <Style x:Key="TipText" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Tip" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Height="34" Padding="18,0" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same switch as in the settings, label on the left. -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="#14FFFFFF" Padding="16,12" CornerRadius="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <ContentPresenter TextElement.FontWeight="SemiBold" />
                                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </StackPanel>
                                <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" CornerRadius="10" VerticalAlignment="Center"
                                        Background="Transparent" BorderBrush="#99FFFFFF" BorderThickness="1">
                                    <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="3,0,0,0" Fill="#CCFFFFFF" HorizontalAlignment="Left" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                <Setter TargetName="Thumb" Property="Margin" Value="24,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" CornerRadius="18" Background="#F51C1C1E" BorderBrush="#26FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="1"
                    Width="30" Height="30" Cursor="Hand" Focusable="False" ToolTip="{DynamicResource Close}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="15">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#B3FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Pages: one visible at a time, sliding in. -->
            <Grid x:Name="Pages" Margin="40,34,40,0" Background="Transparent">

                <!-- 1: hello -->
                <StackPanel VerticalAlignment="Center">
                    <Grid Height="130" Margin="0,0,0,18">
                        <Ellipse Width="300" Height="90" Fill="#30D158" Opacity="0.10">
                            <Ellipse.Effect>
                                <BlurEffect Radius="40" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Rectangle x:Name="HeroIsland" Width="96" Height="12" RadiusX="6" RadiusY="6" Fill="Black"
                                   Stroke="#33FFFFFF" StrokeThickness="1" VerticalAlignment="Center" />
                        <StackPanel x:Name="HeroDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Opacity="0">
                            <Ellipse Width="7" Height="7" Margin="3,0" Fill="#FF9F0A" />
                            <Ellipse Width="7" Height="7" Margin="3,0" Fill="#30D158" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource WelcomeTitle}" />
                    <TextBlock Style="{StaticResource PageText}" Margin="0,10,0,0"
                               Text="{DynamicResource WelcomeIntro}" />
                </StackPanel>

                <!-- 2: using the island -->
                <StackPanel Visibility="Hidden">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource HoverTitle}" Margin="0,0,0,22" />
                    <Grid Style="{StaticResource Tip}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TipGlyph}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE962;" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource TipLead}" Text="{DynamicResource HoverLead}" />
                            <TextBlock Style="{StaticResource TipText}" Text="{DynamicResource HoverText}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Tip}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TipGlyph}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE767;" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource TipLead}" Text="{DynamicResource WheelLead}" />
                            <TextBlock Style="{StaticResource TipText}" Text="{DynamicResource WheelText}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Tip}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TipGlyph}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource TipLead}" Text="{DynamicResource MenuLead}" />
                            <TextBlock Style="{StaticResource TipText}" Text="{DynamicResource MenuText}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Tip}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TipGlyph}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7C2;" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource TipLead}" Text="{DynamicResource MoveLead}" />
                            <TextBlock Style="{StaticResource TipText}" Text="{DynamicResource MoveText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 3: quick actions and shortcuts -->
                <StackPanel Visibility="Hidden">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource QuickTitle}" Margin="0,0,0,22" />
                    <Grid Style="{StaticResource Tip}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TipGlyph}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" Foreground="#FF9F0A" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource TipLead}" Text="{DynamicResource TimerLead}" />
                            <TextBlock Style="{StaticResource TipText}" Text="{DynamicResource TimerText}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Tip}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TipGlyph}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE720;" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource TipLead}" Text="{DynamicResource OutputMicLead}" />
                            <TextBlock x:Name="MicrophoneTip" Style="{StaticResource TipText}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Tip}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TipGlyph}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE71D;" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource TipLead}" Text="{DynamicResource ShortcutsLead}" />
                            <TextBlock Style="{StaticResource TipText}" Text="{DynamicResource ShortcutsText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 4: lights -->
                <StackPanel Visibility="Hidden">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource LightsTitle}" Margin="0,0,0,22" />
                    <Grid Style="{StaticResource Tip}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TipGlyph}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Margin="2,0" Fill="#FF9F0A" />
                                <Ellipse Width="7" Height="7" Margin="2,0" Fill="#30D158" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource TipLead}" Text="{DynamicResource LightsLead}" />
                            <TextBlock Style="{StaticResource TipText}" Text="{DynamicResource LightsText}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Tip}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TipGlyph}"><TextBlock Style="{StaticResource Glyph}" Text="&#xF781;" Foreground="#FF453A" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource TipLead}" Text="{DynamicResource MutedLead}" />
                            <TextBlock Style="{StaticResource TipText}" Text="{DynamicResource MutedText}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource Tip}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource TipGlyph}"><TextBlock Style="{StaticResource Glyph}" Text="&#xE740;" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Style="{StaticResource TipLead}" Text="{DynamicResource AwayLead}" />
                            <TextBlock Style="{StaticResource TipText}" Text="{DynamicResource AwayText}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 5: ready -->
                <StackPanel Visibility="Hidden">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource ReadyTitle}" />
                    <TextBlock Style="{StaticResource PageText}" Margin="0,8,0,20"
                               Text="{DynamicResource ReadyText}" />
                    <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Content="{DynamicResource StartWithWindows}"
                              Tag="{DynamicResource WelcomeStartTip}" />
                    <CheckBox x:Name="AutoUpdateSwitch" Style="{StaticResource Switch}" Content="{DynamicResource AutoUpdate}"
                              Tag="{DynamicResource WelcomeUpdateTip}" />
                </StackPanel>
            </Grid>

            <!-- Navigation: back, progress dots, next. -->
            <Grid Grid.Row="1" Margin="28,14,28,24">
                <Button x:Name="BackButton" Style="{StaticResource NavButton}" HorizontalAlignment="Left" Content="{DynamicResource Back}" Visibility="Hidden" />
                <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Button x:Name="NextButton" Style="{StaticResource NavButton}" HorizontalAlignment="Right" Content="{DynamicResource Next}"
                        Background="{StaticResource Accent}" Foreground="Black" />
            </Grid>
        </Grid>
    </Border>
</Window>
