<Window x:Class="ZeiLand.AodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ZeiLand.Controls"
        Title="ZeiLand AOD"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Background="Black" Foreground="White" FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <!-- Dimmed: it may stay up for hours. -->
        <SolidColorBrush x:Key="Bright" Color="#D9FFFFFF" />
        <SolidColorBrush x:Key="Dim" Color="#80FFFFFF" />
        <SolidColorBrush x:Key="Timer" Color="#CCFF9F0A" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Bright}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="22" Background="#14FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Black">
        <!-- Moved a few pixels every minute, so nothing stays lit in one place (OLED burn-in). -->
        <StackPanel x:Name="Body" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="Shift" />
            </StackPanel.RenderTransform>

            <StackPanel x:Name="PrivacyRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Ellipse x:Name="MicDot" Width="9" Height="9" Margin="5,0" Fill="#CCFF9F0A" />
                <Ellipse x:Name="CameraDot" Width="9" Height="9" Margin="5,0" Fill="#CC30D158" />
            </StackPanel>

            <TextBlock x:Name="ClockText" HorizontalAlignment="Center" FontSize="128" FontWeight="Light"
                       FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{StaticResource Bright}" />
            <TextBlock x:Name="DateText" HorizontalAlignment="Center" Margin="0,-8,0,0" FontSize="22"
                       Foreground="{StaticResource Dim}" />

            <Grid x:Name="MediaRow" HorizontalAlignment="Center" Margin="0,44,0,0" MaxWidth="560">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="MediaArt" Width="56" Height="56" CornerRadius="12" Background="#2C2C2E" Opacity="0.85" />
                <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MediaTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Bright}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MediaArtist" Margin="0,2,0,0" FontSize="14" Foreground="{StaticResource Dim}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="PlayPauseButton" Grid.Column="2" Style="{StaticResource PlayButton}" VerticalAlignment="Center">
                    <TextBlock x:Name="PlayPauseGlyph" FontFamily="{StaticResource IconFont}" FontSize="16" />
                </Button>
            </Grid>

            <StackPanel x:Name="InfoRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <StackPanel x:Name="TimerInfo" Orientation="Horizontal" Margin="14,0">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE916;" FontSize="16" VerticalAlignment="Center"
                               Foreground="{StaticResource Timer}" />
                    <TextBlock x:Name="TimerText" Margin="8,0,0,0" FontSize="18" VerticalAlignment="Center"
                               Foreground="{StaticResource Timer}" />
                </StackPanel>
                <StackPanel x:Name="BatteryInfo" Orientation="Horizontal" Margin="14,0">
                    <controls:BatteryGlyph x:Name="BatteryGlyph" Width="26" Height="13" VerticalAlignment="Center" Opacity="0.8" />
                    <TextBlock x:Name="BatteryText" Margin="8,0,0,0" FontSize="18" VerticalAlignment="Center"
                               Foreground="{StaticResource Dim}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="HintText" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,48"
                   FontSize="13" Foreground="#59FFFFFF" />
    </Grid>
</Window>
