<Window x:Class="ZeiLand.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ZeiLand.Controls"
        Title="{DynamicResource SettingsTitle}"
        Width="460" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#202020" Foreground="White" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="SecondaryText" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#30D158" />

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#D9FFFFFF" />
            <Setter Property="Margin" Value="4,22,0,8" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="16,0" />
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>

        <!-- A whole settings row that toggles: title (Content), optional description (Tag), switch on the right. -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" Padding="16,11" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ContentPresenter />
                                    <TextBlock x:Name="Description" Margin="0,2,0,0" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryText}"
                                               Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                </StackPanel>
                                <Border x:Name="Track" Grid.Column="1" Width="40" Height="20" CornerRadius="10"
                                        VerticalAlignment="Center" Background="Transparent"
                                        BorderBrush="#99FFFFFF" BorderThickness="1">
                                    <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="3,0,0,0" Fill="#CCFFFFFF"
                                             HorizontalAlignment="Left">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform x:Name="ThumbOffset" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#0AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X"
                                                             To="21" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small on/off pills for the individual system readings. -->
        <Style x:Key="Chip" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Pill" Height="26" Padding="12,0" CornerRadius="13" Background="Transparent"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter x:Name="Label" VerticalAlignment="Center"
                                              TextElement.Foreground="{StaticResource SecondaryText}" TextElement.FontSize="12" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#80FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#4030D158" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Padding="11,4" CornerRadius="5" Background="Transparent">
                            <ContentPresenter TextElement.FontSize="12" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#3DFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shows a keyboard shortcut; click, then press the new keys. Tag="Recording" while listening. -->
        <Style x:Key="ShortcutButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="12,5" CornerRadius="6" Background="#1AFFFFFF"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#80FFFFFF" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Recording">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Surface" Property="Background" Value="#2630D158" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="14,6" CornerRadius="6" Background="{StaticResource Accent}">
                            <ContentPresenter TextElement.FontWeight="SemiBold" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A pill button with a glyph (Tag) and a label (Content). -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Height="30" Padding="12,0" CornerRadius="15" Background="#0DFFFFFF"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Margin="0,0,8,0" FontSize="12" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           VerticalAlignment="Center" Foreground="#CCFFFFFF"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="12.5" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#80FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square glyph buttons at the end of a list row (move up/down, remove). -->
        <Style x:Key="RowIcon" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark text box; Tag is the placeholder shown while it's empty. -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="#30D158" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="#14FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                CornerRadius="6" Padding="8,6">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Foreground="#66FFFFFF" Visibility="Collapsed" Margin="2,0,0,0"
                                           Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ScrollViewer x:Name="PART_ContentHost" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim dark scroll bar for the app list. -->
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Margin="2,0" CornerRadius="2" Background="#4DFFFFFF" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="8,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A picture card to choose one of a few looks: preview, title and description in Content. -->
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Padding="8,8,8,10" CornerRadius="10" Background="#2B2B2B"
                                BorderBrush="#14FFFFFF" BorderThickness="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#40FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mock-up pieces for the resting-style previews: a desktop with a maximised browser under the island. -->
        <LinearGradientBrush x:Key="PreviewArt" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6B6B" Offset="0" />
            <GradientStop Color="#B84BFF" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="PreviewTab" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="CornerRadius" Value="3,3,0,0" />
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="PreviewLine" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="#2E2E2E" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,20">
        <Border DockPanel.Dock="Top" Padding="2" CornerRadius="8" Background="#1AFFFFFF" HorizontalAlignment="Left">
            <StackPanel x:Name="Tabs" Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" GroupName="Tabs" Tag="Island" Content="{DynamicResource TabIsland}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="Tabs" Tag="Appearance" Content="{DynamicResource TabAppearance}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="Tabs" Tag="Aod" Content="{DynamicResource TabAod}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="Tabs" Tag="Shortcuts" Content="{DynamicResource TabShortcuts}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="Tabs" Tag="Behaviour" Content="{DynamicResource TabBehaviour}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="Tabs" Tag="About" Content="{DynamicResource TabAbout}" />
            </StackPanel>
        </Border>

        <!-- Inactive pages are hidden, not collapsed, so the window keeps one size across tabs. They scroll when
             the screen is too short for the tallest. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid>
            <StackPanel x:Name="IslandPage">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource ShowOnIsland}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowMedia}"
                                  Content="{DynamicResource PlayingMedia}" Tag="{DynamicResource PlayingMediaTip}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AnimateLevelBars}" IsEnabled="{Binding ShowMedia}"
                                  Margin="16,0,0,0" Content="{DynamicResource AnimateBars}" Tag="{DynamicResource AnimateBarsTip}" />
                        <StackPanel Margin="32,0,16,10" IsEnabled="{Binding ShowMedia}">
                            <TextBlock Text="{DynamicResource MediaSources}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryText}" />
                            <WrapPanel x:Name="MediaSources" Margin="0,8,0,0" />
                            <TextBlock x:Name="MediaSourcesEmpty" Text="{DynamicResource MediaSourcesEmpty}" Margin="0,0,0,4"
                                       FontSize="11.5" Foreground="#66FFFFFF" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowPrivacyIndicators}"
                                  Content="{DynamicResource PrivacyLights}"
                                  Tag="{DynamicResource PrivacyLightsTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowVolume}"
                                  Content="{DynamicResource VolumeIndicator}" Tag="{DynamicResource VolumeIndicatorTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowPower}"
                                  Content="{DynamicResource PowerNotices}" Tag="{DynamicResource PowerNoticesTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowBluetooth}"
                                  Content="{DynamicResource BluetoothNotices}" Tag="{DynamicResource BluetoothNoticesTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowCalls}"
                                  Content="{DynamicResource CallIndicator}" Tag="{DynamicResource CallIndicatorTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowScreenshots}"
                                  Content="{DynamicResource ScreenshotPreview}" Tag="{DynamicResource ScreenshotPreviewTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowNotifications}"
                                  Content="{DynamicResource IslandNotifications}" Tag="{DynamicResource IslandNotificationsTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowClock}"
                                  Content="{DynamicResource ClockDate}" Tag="{DynamicResource ClockDateTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowStats}"
                                  Content="{DynamicResource SystemStats}" Tag="{DynamicResource SystemStatsTip}" />
                        <WrapPanel Margin="16,0,16,10" IsEnabled="{Binding ShowStats}">
                            <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding ShowCpu}" Content="CPU" />
                            <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding ShowCpuTemperature}" IsEnabled="{Binding ShowCpu}" Content="CPU °C" />
                            <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding ShowGpu}" Content="GPU" />
                            <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding ShowGpuTemperature}" IsEnabled="{Binding ShowGpu}" Content="GPU °C" />
                            <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding ShowRam}" Content="RAM" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource CpuTemperature}" />
                <Border Style="{StaticResource Card}" Padding="16,12,16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CpuTemperatureDot" Width="8" Height="8" Margin="0,1,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="CpuTemperatureTitle" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="CpuTemperatureDetail" Margin="16,3,0,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryText}" />
                        <StackPanel x:Name="CpuTemperatureActions" Orientation="Horizontal" Margin="16,10,0,0">
                            <Button x:Name="InstallDriverButton" Style="{StaticResource ActionButton}" Content="{DynamicResource InstallPawnIO}" />
                            <Button x:Name="RestartElevatedButton" Style="{StaticResource ActionButton}" Content="{DynamicResource RestartAsAdmin}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="AppearancePage" Visibility="Hidden">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource WhenClosed}" />
                <TextBlock Margin="4,-4,0,10" FontSize="11.5" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Text="{DynamicResource WhenClosedTip}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="RestingThin" Grid.Column="2" Style="{StaticResource Choice}" GroupName="Resting">
                        <StackPanel>
                            <Grid Height="80" ClipToBounds="True">
                                <Border CornerRadius="6" Background="#1C1C1C">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="13" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border CornerRadius="6,6,0,0" Background="#262626">
                                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                                <Border Style="{StaticResource PreviewTab}" Background="#1C1C1C" />
                                                <Border Style="{StaticResource PreviewTab}" />
                                                <Border Style="{StaticResource PreviewTab}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="12,10,12,0">
                                            <Border Style="{StaticResource PreviewLine}" Width="90" />
                                            <Border Style="{StaticResource PreviewLine}" Width="130" />
                                            <Border Style="{StaticResource PreviewLine}" Width="110" />
                                            <Border Style="{StaticResource PreviewLine}" Width="60" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Width="48" Height="6" CornerRadius="0,0,3,3" Background="Black" VerticalAlignment="Top">
                                    <Border Width="18" Height="2" CornerRadius="1" Background="#30D158"
                                            VerticalAlignment="Bottom" Margin="0,0,0,1" />
                                </Border>
                            </Grid>
                            <TextBlock Margin="4,10,0,0" Text="{DynamicResource ThinLine}" FontWeight="SemiBold" />
                            <TextBlock Margin="4,2,0,0" FontSize="11.5" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                       Text="{DynamicResource ThinLineTip}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RestingPlayer" Style="{StaticResource Choice}" GroupName="Resting">
                        <StackPanel>
                            <Grid Height="80" ClipToBounds="True">
                                <Border CornerRadius="6" Background="#1C1C1C">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="13" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border CornerRadius="6,6,0,0" Background="#262626">
                                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                                <Border Style="{StaticResource PreviewTab}" Background="#1C1C1C" />
                                                <Border Style="{StaticResource PreviewTab}" />
                                                <Border Style="{StaticResource PreviewTab}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="12,10,12,0">
                                            <Border Style="{StaticResource PreviewLine}" Width="90" />
                                            <Border Style="{StaticResource PreviewLine}" Width="130" />
                                            <Border Style="{StaticResource PreviewLine}" Width="110" />
                                            <Border Style="{StaticResource PreviewLine}" Width="60" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Width="124" Height="18" CornerRadius="9" Background="Black" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Grid>
                                        <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource PreviewArt}"
                                                HorizontalAlignment="Left" Margin="4,0,0,0" />
                                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="21,0,0,0">
                                            <Border Width="44" Height="3" CornerRadius="1.5" Background="#DDFFFFFF" />
                                            <Border Width="30" Height="2.5" CornerRadius="1.25" Background="#66FFFFFF" Margin="0,2,0,0"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="0,0,8,0">
                                            <Rectangle Width="2" Height="5" Fill="#30D158" Margin="0,0,1.5,0" VerticalAlignment="Bottom" />
                                            <Rectangle Width="2" Height="8" Fill="#30D158" Margin="0,0,1.5,0" VerticalAlignment="Bottom" />
                                            <Rectangle Width="2" Height="6" Fill="#30D158" Margin="0,0,1.5,0" VerticalAlignment="Bottom" />
                                            <Rectangle Width="2" Height="3" Fill="#30D158" VerticalAlignment="Bottom" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <TextBlock Margin="4,10,0,0" Text="{DynamicResource MiniPlayer}" FontWeight="SemiBold" />
                            <TextBlock Margin="4,2,0,0" FontSize="11.5" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                       Text="{DynamicResource MiniPlayerTip}" />
                        </StackPanel>
                    </RadioButton>
                </Grid>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Position}" />
                <Border Style="{StaticResource Card}">
                    <Grid Margin="16,11,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="PositionTitle" />
                            <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                       Text="{DynamicResource PositionTip}" />
                        </StackPanel>
                        <Button x:Name="CentreButton" Grid.Column="1" Style="{StaticResource ActionButton}" Margin="0"
                                VerticalAlignment="Center" Content="{DynamicResource Centre}" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource IslandSize}" />
                <Border Style="{StaticResource Card}">
                    <Grid Margin="16,10,16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryText}" Text="{DynamicResource IslandSizeTip}" />
                        <Border Grid.Column="1" Padding="2" CornerRadius="7" Background="#1AFFFFFF" VerticalAlignment="Center">
                            <StackPanel x:Name="SizeOptions" Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Size" Tag="0.9" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Size" Tag="1" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Size" Tag="1.1" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Size" Tag="1.25" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="GIF" />
                <Border Style="{StaticResource Card}" Padding="14,12,16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="104" Height="52" CornerRadius="12" Background="Black" BorderBrush="#26FFFFFF"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="GifPlaceholder" Text="&#xE8B9;" FontSize="18" Foreground="#4DFFFFFF"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <controls:GifImage x:Name="GifPreview" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource GifInPlayer}" />
                            <TextBlock x:Name="GifDetail" Margin="0,2,0,0" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Button x:Name="GifPickButton" Style="{StaticResource ActionButton}" Content="{DynamicResource PickGif}" />
                                <Button x:Name="GifRemoveButton" Style="{StaticResource LinkButton}" Margin="0" Tag="&#xE74D;"
                                        Content="{DynamicResource Remove}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource PlayerButtons}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="16,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource SkipButtons}" />
                                <TextBlock Margin="0,2,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}"
                                           Text="{DynamicResource SkipButtonsTip}" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="2" CornerRadius="7" Background="#1AFFFFFF" VerticalAlignment="Center">
                                <StackPanel x:Name="SkipOptions" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Skip" Tag="0" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Skip" Tag="5" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Skip" Tag="10" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Skip" Tag="15" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Skip" Tag="30" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Margin="16,10,16,0" Text="{DynamicResource QuickButtons}" />
                        <TextBlock Margin="16,2,16,8" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource SecondaryText}"
                                   Text="{DynamicResource QuickButtonsTip}" />
                        <WrapPanel Margin="16,0,16,10">
                            <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding ShowTimerButton}" Content="{DynamicResource TimerButton}" />
                            <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding ShowSoundButton}" Content="{DynamicResource SoundButton}" />
                            <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding ShowMicButton}" Content="{DynamicResource MicButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="AodPage" Visibility="Hidden">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource AodTitle}" />
                <TextBlock Margin="4,-4,0,10" FontSize="11.5" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Text="{DynamicResource AodIntro}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AodEnabled}"
                                  Content="{DynamicResource AodEnable}" Tag="{DynamicResource AodEnableTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <StackPanel IsEnabled="{Binding AodEnabled}">
                        <Grid Margin="16,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AodWhen}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Padding="2" CornerRadius="7" Background="#1AFFFFFF" VerticalAlignment="Center">
                                <StackPanel x:Name="AodWhenOptions" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AodWhen" Tag="Idle" Content="{DynamicResource AodIdle}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AodWhen" Tag="Always" Content="{DynamicResource AodAlways}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid Margin="16,10,16,10" x:Name="AodWaitRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource AodWait}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Padding="2" CornerRadius="7" Background="#1AFFFFFF" VerticalAlignment="Center">
                                <StackPanel x:Name="AodWaitOptions" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AodWait" Tag="1" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AodWait" Tag="2" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AodWait" Tag="5" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="AodWait" Tag="10" />
                                </StackPanel>
                            </Border>
                        </Grid>
                            <StackPanel x:Name="AodScreenRow">
                                <Border Style="{StaticResource Divider}" />
                                <Grid Margin="16,10,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource AodScreen}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <Border Grid.Column="1" Padding="2" CornerRadius="7" Background="#1AFFFFFF" HorizontalAlignment="Right">
                                        <WrapPanel x:Name="AodScreens" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" />
                            <TextBlock Margin="16,10,16,8" Text="{DynamicResource AodShows}" />
                            <WrapPanel Margin="16,0,16,10">
                                <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding AodClock}" Content="{DynamicResource AodClock}" />
                                <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding AodDate}" Content="{DynamicResource AodDate}" />
                                <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding AodMedia}" Content="{DynamicResource AodMedia}" />
                                <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding AodTimer}" Content="{DynamicResource TimerTitle}" />
                                <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding AodBattery}" Content="{DynamicResource AodBattery}" />
                                <CheckBox Style="{StaticResource Chip}" IsChecked="{Binding AodPrivacy}" Content="{DynamicResource AodPrivacy}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="AodPreviewButton" Style="{StaticResource LinkButton}" Tag="&#xE890;" Content="{DynamicResource AodPreview}" />
                </WrapPanel>
                <TextBlock Margin="4,0,0,0" FontSize="11.5" Foreground="#66FFFFFF" TextWrapping="Wrap" Text="{DynamicResource AodNote}" />
            </StackPanel>

            <StackPanel x:Name="ShortcutsPage" Visibility="Hidden">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource TabShortcuts}" />
                <TextBlock Margin="4,-4,0,10" FontSize="11.5" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Text="{DynamicResource ShortcutsTip}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel x:Name="ShortcutList" Margin="0,4" />
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Add}" />
                <WrapPanel>
                    <Button x:Name="AddAppButton" Style="{StaticResource LinkButton}" Tag="&#xE71D;" Content="{DynamicResource App}" />
                    <Button x:Name="AddFileButton" Style="{StaticResource LinkButton}" Tag="&#xE8A5;" Content="{DynamicResource File}" />
                    <Button x:Name="AddFolderButton" Style="{StaticResource LinkButton}" Tag="&#xE8B7;" Content="{DynamicResource Folder}" />
                    <Button x:Name="AddWebsiteButton" Style="{StaticResource LinkButton}" Tag="&#xE774;" Content="{DynamicResource Website}" />
                </WrapPanel>

                <Border x:Name="AppPicker" Style="{StaticResource Card}" Padding="10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBox x:Name="AppSearch" Style="{StaticResource Field}" Tag="{DynamicResource SearchApps}" />
                        <TextBlock x:Name="AppPickerStatus" Margin="4,8,0,0" FontSize="11.5" Foreground="{StaticResource SecondaryText}" />
                        <ListBox x:Name="AppList" Height="220" Margin="0,4,0,0" Background="Transparent" BorderThickness="0"
                                 Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource PickerItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border x:Name="WebsiteForm" Style="{StaticResource Card}" Padding="10" Visibility="Collapsed">
                    <StackPanel>
                        <TextBox x:Name="WebsiteAddress" Style="{StaticResource Field}" Tag="{DynamicResource AddressHint}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WebsiteName" Style="{StaticResource Field}" Tag="{DynamicResource NameHint}" />
                            <Button x:Name="WebsiteAddButton" Grid.Column="1" Style="{StaticResource ActionButton}"
                                    Margin="8,0,0,0" VerticalAlignment="Center" Content="{DynamicResource Add}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ShortcutStatus" Margin="4,8,0,0" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryText}" />
            </StackPanel>

            <StackPanel x:Name="BehaviourPage" Visibility="Hidden">
                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource TabBehaviour}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="16,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- In both languages, so it can be found from either. -->
                            <TextBlock Text="Dil · Language" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Padding="2" CornerRadius="7" Background="#1AFFFFFF" VerticalAlignment="Center">
                                <StackPanel x:Name="LanguageOptions" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Language" Tag="tr" Content="Türkçe" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Language" Tag="en" Content="English" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Margin="16,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource OpenDelay}" />
                                <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="{StaticResource SecondaryText}"
                                           TextWrapping="Wrap" Text="{DynamicResource OpenDelayTip}" />
                            </StackPanel>
                            <Border Grid.Column="1" Padding="2" CornerRadius="7" Background="#1AFFFFFF" VerticalAlignment="Center">
                                <StackPanel x:Name="HoverDelayOptions" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="HoverDelay" Tag="0" Content="{DynamicResource Instant}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="HoverDelay" Tag="220" Content="{DynamicResource Normal}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="HoverDelay" Tag="500" Content="{DynamicResource Slow}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding WheelControlsVolume}"
                                  Content="{DynamicResource WheelVolume}" Tag="{DynamicResource WheelVolumeTip}" />
                        <Grid Margin="32,0,16,12" IsEnabled="{Binding WheelControlsVolume}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource WheelStep}" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource SecondaryText}" />
                            <Border Grid.Column="1" Padding="2" CornerRadius="7" Background="#1AFFFFFF">
                                <StackPanel x:Name="WheelStepOptions" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="WheelStep" Tag="1" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="WheelStep" Tag="2" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="WheelStep" Tag="5" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <Grid Margin="16,10,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource MicShortcut}" />
                                <TextBlock x:Name="ShortcutDescription" Margin="0,2,0,0" FontSize="11.5" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="ShortcutButton" Grid.Column="1" Style="{StaticResource ShortcutButton}"
                                    VerticalAlignment="Center" />
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TimerSound}"
                                  Content="{DynamicResource TimerSound}" Tag="{DynamicResource TimerSoundTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HideInFullscreen}"
                                  Content="{DynamicResource HideFullscreen}" Tag="{DynamicResource HideFullscreenTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox x:Name="AutostartToggle" Style="{StaticResource Switch}"
                                  Content="{DynamicResource StartWithWindows}" Tag="{DynamicResource StartWithWindowsTip}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="AboutPage" Visibility="Hidden">
                <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="16" CornerRadius="8" Background="Black" BorderBrush="#40FFFFFF"
                                BorderThickness="1" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock x:Name="AboutTitle" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                       Text="{DynamicResource AboutTagline}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Updates}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoUpdate}" Content="{DynamicResource AutoUpdate}"
                                  Tag="{DynamicResource AutoUpdateTip}" />
                        <Border Style="{StaticResource Divider}" />
                        <Grid Margin="16,10,16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="UpdateTitle" />
                                <TextBlock x:Name="UpdateDetail" Margin="0,2,0,0" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <Button x:Name="UpdateButton" Grid.Column="1" Style="{StaticResource ActionButton}" Margin="0"
                                    VerticalAlignment="Center" Content="{DynamicResource CheckNow}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource More}" />
                <WrapPanel>
                    <Button x:Name="WelcomeButton" Style="{StaticResource LinkButton}" Tag="&#xE897;" Content="{DynamicResource WelcomeGuide}" />
                    <Button x:Name="LicenseButton" Style="{StaticResource LinkButton}" Tag="&#xE8A5;" Content="{DynamicResource License}" />
                    <Button x:Name="ReleasesButton" Style="{StaticResource LinkButton}" Tag="&#xE774;" Content="{DynamicResource Releases}" />
                    <Button x:Name="ResetButton" Style="{StaticResource LinkButton}" Tag="&#xE72C;" Content="{DynamicResource ResetSettings}" />
                </WrapPanel>

                <TextBlock x:Name="VersionText" Margin="4,8,0,0" FontSize="11.5" Foreground="#66FFFFFF" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
