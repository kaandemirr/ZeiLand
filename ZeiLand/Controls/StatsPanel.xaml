<UserControl x:Class="ZeiLand.Controls.StatsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="0,10,0,0">

    <UserControl.Resources>
        <Style x:Key="Column" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#66FFFFFF" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,1,0,5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Track" TargetType="Border">
            <Setter Property="Height" Value="3" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="#26FFFFFF" />
        </Style>
        <Style x:Key="Fill" TargetType="Border">
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="Background" Value="#E6FFFFFF" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Hidden columns collapse and the rest share the width. -->
        <UniformGrid Rows="1">
            <StackPanel x:Name="CpuColumn" Style="{StaticResource Column}">
                <TextBlock Style="{StaticResource Label}" Text="CPU" />
                <TextBlock Style="{StaticResource Value}">
                    <Run x:Name="CpuValue" /><Run x:Name="CpuTemperature" FontWeight="Normal" />
                </TextBlock>
                <Border Style="{StaticResource Track}">
                    <Border Style="{StaticResource Fill}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CpuScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>

            <StackPanel x:Name="GpuColumn" Style="{StaticResource Column}">
                <TextBlock Style="{StaticResource Label}" Text="GPU" />
                <TextBlock Style="{StaticResource Value}">
                    <Run x:Name="GpuValue" /><Run x:Name="GpuTemperature" FontWeight="Normal" />
                </TextBlock>
                <Border Style="{StaticResource Track}">
                    <Border Style="{StaticResource Fill}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="GpuScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>

            <StackPanel x:Name="RamColumn" Style="{StaticResource Column}">
                <TextBlock Style="{StaticResource Label}" Text="RAM" />
                <TextBlock Style="{StaticResource Value}">
                    <Run x:Name="RamValue" /><Run x:Name="RamUsed" FontWeight="Normal" Foreground="#99FFFFFF" />
                </TextBlock>
                <Border Style="{StaticResource Track}">
                    <Border Style="{StaticResource Fill}">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="RamScale" ScaleX="0" />
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
        </UniformGrid>

        <!-- Opens the "what is using my PC" panel. -->
        <Button x:Name="OptimizeButton" Grid.Column="1" Width="34" Height="34" VerticalAlignment="Center"
                Focusable="False" Cursor="Hand" ToolTip="{DynamicResource OptimizeTip}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="#1AFFFFFF" CornerRadius="17">
                        <Path Data="M7.5,0 L1,9.5 H5.6 L4.6,16 L11,6.5 H6.4 Z" Fill="White"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#4DFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
